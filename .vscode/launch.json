                "--num_images_in_input",
                "2",
                "--use_film",
                "False",
                "--pretrained_checkpoint",
                "outputs/object/object_lora_011--36000_chkpt",  // ckpt dir
                "--task_suite_name",
                "libero_object",  // libero_spatial, libero_object, libero_goal, libero_10
                "--use_pro_version",
                "True",  // True or False
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "3",
            },
        },
        {
            "name": "eval_liberoplus",
            "type": "debugpy",
            "request": "launch",
